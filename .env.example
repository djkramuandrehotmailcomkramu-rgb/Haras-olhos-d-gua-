# Servidor (Vercel > Settings > Environment Variables). Nunca commitar valores reais.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-anon-legacy-JWT        # só no servidor; o celular nunca vê
VAPID_PUBLIC=                              # npx web-push generate-vapid-keys
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:voce@exemplo.com
CRON_SECRET=string-aleatoria-longa         # a Vercel envia como Bearer no cron
# Cliente (embutida no build)
VITE_VAPID_PUBLIC=mesma-chave-VAPID_PUBLIC
